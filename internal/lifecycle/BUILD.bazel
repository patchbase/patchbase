load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lifecycle",
    srcs = ["lifecycle.go"],
    embedsrcs = ["catalog.json"],
    importpath = "go.patchbase.net/server/internal/lifecycle",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/utils"],
