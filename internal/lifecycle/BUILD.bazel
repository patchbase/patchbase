go_test(
    name = "lifecycle_test",
    size = "small",
    srcs = ["lifecycle_test.go"],
    deps = [
        ":lifecycle",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
