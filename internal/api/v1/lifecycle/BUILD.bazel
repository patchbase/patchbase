load("//third_party/bazel:go_rules.bzl", "go_api_library", "integration_test")

go_api_library(
    name = "lifecycle",
    srcs = [
        "get.go",
        "list.go",
    ],
    importpath = "go.patchbase.net/server/internal/api/v1/lifecycle",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/api/auth",
        "//internal/api/v1/entities",
        "//internal/api/webutil",
        "//internal/services",
        "@com_github_samber_do_v2//:do",
    ],
)

integration_test(
    name = "get_test",
    srcs = ["get_test.go"],
    deps = [
        "//internal/testing",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

integration_test(
    name = "list_test",
    srcs = ["list_test.go"],
    deps = [
        "//internal/testing",
        "//proto/agent",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
